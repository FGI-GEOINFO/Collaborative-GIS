NODE_ENV=production
PROXY_PORT=8085
SHARING_PORT=8086
LAYMAN_PORT=8087
DB_PATH=data/hslayers-server.db
SESSION_SECRET=************** # Placeholder value. Replace with OAuth2 session secret key.
# 60 * 60 * 24 * 7 = 7 days
SESSION_MAX_AGE=604800
PAYLOAD_LIMIT=2mb
LAYMAN_BASEURL=https://<DomainName>/client # Replace <DomainName> with actual domain
LAYMAN_USER_PROFILE_URL=https://<DomainName>/client/rest/current-user # Replace <DomainName> with actual domain
OAUTH2_AUTH_URL=https://<DomainName>/o/authorize # Replace <DomainName> with actual domain
OAUTH2_TOKEN_URL=http://wagtail:8000/o/token/
OAUTH2_CLIENT_ID==************** # Placeholder value. Replace value and make sure it matches Layman .env OAUTH2_CLIENT_ID value.
OAUTH2_SECRET==************** # Placeholder value. Replace value and make sure it matches Layman .env OAUTH2_CLIENT_SECRET value.
OAUTH2_CALLBACK_URL=https://<DomainName>/layman/callback # Replace <DomainName> with actual domain
CORS_WHITELIST=["https://<DomainName>", "https://<DomainName>/client", "http://localhost:4200"] # Replace <DomainName> with actual domain
SUCCESS_REDIRECT_URL=https://<DomainName> # Replace <DomainName> with actual domain
HS_GEONAMES_API_KEY=*****
OPENROUTESERVICE_API_KEY=*****
